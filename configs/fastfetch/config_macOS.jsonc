// Modified from: 26.jsonc
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"display": {
		"separator": " ",
		"constants": [
			// CONSTANT {$1} - VERTICAL BARS AT START AND 75th CHARACTERS FORWARD AND BACKWARD
			"\u001b[90m│                                                            │\u001b[60D\u001b[39m"
		],
		"bar": {
			"width": 10,
			"char": {
				"elapsed": "■",
				"total": "□"
			}
		},
		"percent": {
			"type": 3,
			"color": {
				"green": "light_green",
				"yellow": "light_yellow",
				"red": "light_red"
			}
		}
	},
	"modules": [
		{
			"type": "custom",
			"key": "{#90}╭ System ───╮",
			"format": "{#90}╭────────────────────────────────────────────────────────────╮"
		},
		{
			"type": "title",
			"key": "{#90}│ {#96}User      {#90}│",
			"format": "{$1}{user-name}@{host-name} {#2}[{home-dir}]"
		},
		{
			"type": "os",
			"key": "{#90}│ {#96}OS        {#90}│",
			"format": "{$1}{pretty-name} {#2}[{version}] [{arch}]"
		},
		{
			"type": "kernel",
			"key": "{#90}│ {#96}Kernel    {#90}│",
			"format": "{$1}{sysname} {#2}[{release}] [{page-size}]"
		},
		{
			"type": "bios",
			"key": "{#90}│ {#96}BIOS      {#90}│",
			"format": "{$1}{vendor} {version} {#2}[{type}]{?release} [{release}]{?}"
		},
		{
			"type": "bootmgr",
			"key": "{#90}│ {#96}Boot Mgr. {#90}│",
			"format": "{$1}{name}{?secure-boot} (secure-boot){?}"
		},
		{
			"type": "host",
			"key": "{#90}│ {#96}Host      {#90}│",
			"format": "{$1}{vendor} {#2}[{name<40}]"
		},
		{
			"type": "uptime",
			"key": "{#90}│ {#96}Uptime    {#90}│",
			"format": "{$1}{formatted} {#2}[{days}:{hours}:{minutes}:{seconds}.{milliseconds}]"
		},
		{
			"type": "datetime",
			"key": "{#90}│ {#96}Datetime  {#90}│",
			"format": "{$1}{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty} {#2}[{weekday}] [W{week}] [UTC{offset-from-utc}]"
		},
		{
			"type": "packages",
			"key": "{#90}│ {#96}Packages  {#90}│",
			"format": "{$1}Brew: {brew}, Brew-Cask: {brew-cask} {#2}[Total: {all}]"
		},
		{
			"type": "terminal",
			"key": "{#90}│ {#96}Terminal  {#90}│",
			"format": "{$1}{pretty-name} {#2}[{version}]"
		},
		{
			"type": "shell",
			"key": "{#90}│ {#96}Shell     {#90}│",
			"format": "{$1}{pretty-name} {#2}[{version}] [PID:{pid}]"
		},
		{
			"type": "version",
			"key": "{#90}│ {#96}Fastfetch {#90}│",
			"format": "{$1}{project-name} {version} {#2}[{build-type}]"
		},
		{
			"type": "locale",
			"key": "{#90}│ {#96}Locale    {#90}│",
			"format": "{$1}{result}"
		},
		{
			"type": "custom",
			"key": "{#90}╰───────────╯",
			"format": "{#90}╰────────────────────────────────────────────────────────────╯"
		},

		{
			"type": "custom",
			"key": "{#90}╭ Hardware ─╮",
			"format": "{#90}╭────────────────────────────────────────────────────────────╮"
		},
		{
			"type": "memory",
			"key": "{#90}│ {#94}Memory    {#90}│",
			"format": "{$1}{percentage-bar} {used} / {total} ({percentage})"
		},
		{
			"type": "swap",
			"key": "{#90}│ {#94}Swap      {#90}│",
			"format": "{$1}{percentage-bar} {used} / {total} ({percentage})"
		},
		{
			"type": "disk",
			"key": "{#90}│ {#94}Disk      {#90}│",
			"format": "{$1}{size-percentage-bar} {size-used} / {size-total} ({size-percentage}) {#2}[{filesystem}]"
		},
		{
			"type": "cpu",
			"key": "{#90}│ {#94}CPU       {#90}│",
			"showPeCoreCount": true,
			"temp": true,
			"format": "{$1}{name} {#2}[C:{core-types}] [{freq-max}]{?temperature} [{temperature}{#2}]{?}"
		},
		{
			"type": "gpu",
			"key": "{#90}│ {#94}GPU       {#90}│",
			"detectionMethod": "auto",
			"driverSpecific": true,
			"format": "{$1}{name} {#2}[C:{core-count}]{?frequency} [{frequency}]{?}{?temperature} [{temperature}]{?} [{type}]"
		},
		{
			"type": "board",
			"key": "{#90}│ {#94}Board     {#90}│",
			"format": "{$1}{vendor} {name} {#2}{?version} [{version}]{?}"
		},
		{
			"type": "display",
			"key": "{#90}│ {#94}Display   {#90}│",
			"format": "{$1}{name}{?is-primary} (prim){?}{?hdr-enabled} HDR{?} {width}x{height} {refresh-rate} Hz {inch}\" {#2}[{type}] [PPI:{ppi}]"
		},
		{
			"type": "bluetooth",
			"key": "{#90}│ {#94}Bluetooth {#90}│",
			"format": "{$1}{name} ({type}) {#2}[{battery-percentage}]"
		},
		{
			"type": "custom",
			"key": "{#90}╰───────────╯",
			"format": "{#90}╰────────────────────────────────────────────────────────────╯"
		},

		{
			"type": "custom",
			"key": "{#90}╭ Theme ────╮",
			"format": "{#90}╭────────────────────────────────────────────────────────────╮"
		},
		{
			"type": "de",
			"key": "{#90}│ {#95}DE        {#90}│",
			"format": "{$1}{pretty-name} ({process-name}) {#2}[{version}]"
		},
		{
			"type": "wm",
			"key": "{#90}│ {#95}WM        {#90}│",
			"format": "{$1}{pretty-name} ({process-name}) {#2}{?protocol-name} [{protocol-name}]{?}"
		},
		{
			"type": "wmtheme",
			"key": "{#90}│ {#95}WM Theme  {#90}│",
			"format": "{$1}{result}"
		},
		{
			"type": "theme",
			"key": "{#90}│ {#95}Theme     {#90}│",
			"format": "{$1}{theme1}"
		},
		{
			"type": "icons",
			"key": "{#90}│ {#95}Icons     {#90}│",
			"format": "{$1}{icons1}, {icons2}"
		},
		{
			"type": "font",
			"key": "{#90}│ {#95}Fonts     {#90}│",
			"format": "{$1}{combined}"
		},
		{
			"type": "cursor",
			"key": "{#90}│ {#95}Cursor    {#90}│",
			"format": "{$1}{theme} {#2}[{size}px]"
		},
		{
			"type": "custom",
			"key": "{#90}╰───────────╯",
			"format": "{#90}╰────────────────────────────────────────────────────────────╯"
		}
	]
}
